---
import ProductCard from '@/components/islands/ProductCard';
import { products } from '@/data/products-data';

const bestSellers = products.filter((product) => product.isBestSeller);
---

<article
  class="flex h-fit w-full flex-col items-center justify-between gap-32 py-14"
>
  <h2
    class="pl-10 font-commissioner text-3xl font-bold text-primary-500 tablet:text-4xl"
  >
    Los más vendidos
  </h2>
  <div
    class="flex h-fit w-full flex-col items-center justify-center gap-9 tablet:flex-row tablet:gap-6 tablet:p-4"
  >
    {
      bestSellers.map((product) => (
        <ProductCard product={product} client:visible />
      ))
    }
  </div>
</article>
