---
import { CaretCircleRight } from '@phosphor-icons/react';
import { ButtonLink } from '@/components/custom/ButtonLink';
import aboutIntro from '@/assets/about-intro.webp';
import { Image } from 'astro:assets';
---

<section
  class="flex h-fit w-full flex-col items-center justify-center gap-4 p-10 mobile:w-4/5 laptop:flex-row desktop:h-[640px] desktop:gap-11 desktop:px-5 2xl:h-[800px] 2xl:gap-10"
>
  <!-- izquierda -->
  <div
    class="laptop:h-6/7 flex h-fit w-full flex-col items-center justify-center py-8 tablet:items-start tablet:justify-start laptop:w-1/2"
  >
    <div
      class="flex h-fit w-full flex-col gap-20 py-14 laptop:h-full 2xl:h-[637px] 2xl:w-[629px]"
    >
      <h2
        class="text-center font-commissioner text-3xl font-bold text-primary-500 tablet:text-left tablet:text-5xl"
      >
        ¡Descubre la belleza natural con <span
          class="text-3xl font-black text-primary-300 tablet:text-5xl"
          >GREEN GLOW®</span
        >
      </h2>
      <p
        class="w-full text-balance text-center font-fredoka text-base font-semibold text-primary-300 tablet:text-left tablet:text-xl"
      >
        Te invitamos a experimentar la belleza en su forma más pura, natural,
        efectiva y consciente. Únete a nosotros en este viaje hacia un futuro
        más verde y radiante.
      </p>
    </div>
    <div
      class="mobile:flow-row h-1/8 flex w-fit items-center gap-4 p-4 mobile:justify-center laptop:justify-start"
    >
      <ButtonLink
        href="/about"
        variant="default"
        className="flex flex-row justify-center rounded-3xl bg-primary-800 font-fredoka text-xs text-primary-300 mobile:text-lg mobile:font-medium"
        client:load
      >
        Conócenos <CaretCircleRight />
      </ButtonLink>
      <ButtonLink
        href="/productos"
        variant="outline"
        className="flex flex-row justify-center rounded-3xl border-2 border-primary-800 bg-transparent font-fredoka text-xs text-primary-300 mobile:text-lg mobile:font-medium"
        client:load
      >
        Ver productos
      </ButtonLink>
    </div>
  </div>
  <!-- derecha -->
  <div
    class="relative h-[400px] w-full overflow-hidden rounded-3xl tablet:h-[600px] laptop:w-1/2 desktop:h-full"
  >
    <!-- Imagen de fondo optimizada -->
    <Image
      src={aboutIntro}
      alt=""
      aria-hidden="true"
      class="absolute left-0 top-0 size-full object-cover"
      width={1200}
      height={800}
      format="webp"
      sizes="(max-width: 1024px) 100vw, 50vw"
    />
    <!-- Overlay para contraste -->
    <div class="absolute inset-0 bg-black/40"></div>
  </div>
</section>
