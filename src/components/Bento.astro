---
import { Image } from 'astro:assets';

import { ButtonLink } from '@/components/custom/ButtonLink';

import {
  Drop,
  Coin,
  HandSoap,
  FlowerLotus,
  MarkerCircle,
  JarLabel,
} from '@phosphor-icons/react';

import products from '@/assets/prod-Todos-los-productos.jpg';
import aceites from '@/assets/prod-Aceite-anti-stress.jpg';
import cremas from '@/assets/prod-Crema-descontracturante.jpg';
import cosmeticos from '@/assets/prod-Serum-facial.jpg';
import geles from '@/assets/prod-Gel-de-limpieza.jpg';
import unguentos from '@/assets/prod-Unguento-medicinales.jpg';
---

<article>
  <div class="flex flex-col items-start gap-10 pl-10 py-10">
    <h3
      class="font-commissioner text-primary-500 font-bold text-3xl tablet:text-4xl"
    >
      Explora nuestro catálogo
    </h3>
    <p
      class="font-fredoka text-primary-300 font-medium text-xs tablet:font-medium tablet:text-xl"
    >
      Encuentra el producto que se adecue a tus necesidades
    </p>
  </div>
  <!-- Todos los productos -->
  <div class="flex flex-col items-center">
    <div
      class="flex flex-col relative items-center tablet:grid tablet:grid-cols-5 tablet:grid-rows-2 h-fit w-full tablet:w-11/12 py-10 tablet:py-11 gap-6"
    >
      <div
        class="flex flex-col tablet:col-span-2 tablet:row-span-2 items-center justify-center h-fit w-[320px] tablet:w-full tablet:h-full gap-10 rounded-3xl bg-primary-100/20"
      >
        <div
          class="flex flex-col gap-6 pt-3 mobile:pt-0 items-center justify-evenly w-full h-1/3"
        >
          <h4
            class="text-2xl laptop:text-4xl text-center font-commissioner font-semibold text-primary-500"
          >
            Todos los productos
          </h4>
          <p
            class="text-center text-wrap text-xs tablet:text-base laptop:text-xl font-fredoka font-light text-primary-300"
          >
            Descubre todos nuestros productos especialmente elaborados con los
            mejores ingredientes
          </p>
          <ButtonLink
            href="/products"
            variant={'default'}
            className="font-fredoka text-primary-800 text-xs desktop:text-base font-normal rounded-2xl bg-primary-300 "
          >
            <FlowerLotus /> Todos los productos</ButtonLink
          >
        </div>
        <div
          class="w-full h-[190px] tablet:h-[170px] laptop:h-[325px] desktop:h-[473px] overflow-hidden rounded-b-xl tablet:rounded-none"
        >
          <Image src={products} alt={'todos los productos'} />
        </div>
      </div>

      <!-- Aceites -->

      <div
        class="flex flex-col tablet:col-span-auto tablet:row-span-auto items-center justify-center py-8 h-fit w-[320px] tablet:w-full tablet:h-full gap-6 rounded-3xl bg-primary-100/20"
      >
        <div
          class="w-full h-[252px] tablet:h-[102px] laptop:h-[205px] desktop:h-[303px] overflow-hidden"
        >
          <Image
            src={aceites}
            alt={'aceites'}
            layout="responsive"
            class={'w-full scale-150 h-full'}
          />
        </div>
        <div
          class="flex flex-col w-full h-1/3 items-center justify-around gap-6"
        >
          <ButtonLink
            href="/productos/aceites"
            variant={'default'}
            className="font-fredoka text-primary-800 text-xs desktop:text-base font-normal rounded-2xl bg-primary-300 "
          >
            <Drop /> Aceites</ButtonLink
          >
        </div>
      </div>
      <!-- cosméticos -->
      <div
        class="pt-3 mobile:pt-0 flex flex-col mobile:flex-row tablet:col-span-2 tablet:row-span-1 items-center justify-center h-fit w-[320px] tablet:w-full tablet:h-full gap-6 rounded-3xl bg-primary-100/20"
      >
        <div
          class="flex flex-col ml-2 items-center h-full w-full mobile:w-1/2 justify-center gap-6"
        >
          <h4
            class="text-2xl laptop:text-4xl text-center font-commissioner font-semibold text-primary-500"
          >
            Cosméticos
          </h4>
          <p
            class="text-center text-wrap text-xs laptop:text-xl font-fredoka font-light text-primary-300"
          >
            Conoce nuestra variedad de cosméticos elaborados con ingredientes
            naturales
          </p>
          <ButtonLink
            href="/productos/cosméticos"
            variant={'default'}
            className="font-fredoka text-primary-800 text-xs desktop:text-base font-normal rounded-2xl bg-primary-300 "
          >
            <MarkerCircle /> Cosméticos</ButtonLink
          >
        </div>
        <div class="w-full mobile:w-1/2 h-full overflow-hidden">
          <Image
            src={cosmeticos}
            alt={'cosméticos'}
            layout="responsive"
            class={'w-full h-full rounded-b-xl mobile:rounded-bl-none mobile:rounded-r-3xl'}
          />
        </div>
      </div>
      <!-- Cremas -->
      <div
        class="flex flex-col tablet:col-span-auto tablet:row-span-auto items-center justify-center py-8 h-fit w-[320px] tablet:w-full tablet:h-full gap-6 rounded-3xl bg-primary-100/20"
      >
        <div
          class="w-full h-[252px] tablet:h-[102px] laptop:h-[205px] desktop:h-[303px] overflow-hidden"
        >
          <Image
            src={cremas}
            alt={'cremas'}
            layout="responsive"
            class={'w-full scale-150 ml-10 h-full'}
          />
        </div>
        <div
          class="flex flex-col w-full h-1/3 items-center justify-around gap-6"
        >
          <ButtonLink
            href="/productos/cremas"
            variant={'default'}
            className="font-fredoka text-primary-800 text-xs desktop:text-base font-normal rounded-2xl bg-primary-300 "
          >
            <Coin /> Cremas</ButtonLink
          >
        </div>
      </div>
      <!-- Geles -->
      <div
        class="flex flex-col tablet:col-span-auto tablet:row-span-auto items-center justify-center py-8 h-fit w-[320px] tablet:w-full tablet:h-full gap-6 rounded-3xl bg-primary-100/20"
      >
        <div
          class="w-full h-[252px] tablet:h-[102px] laptop:h-[205px] desktop:h-[303px] overflow-hidden"
        >
          <Image
            src={geles}
            alt={'geles'}
            layout="responsive"
            class={'w-full h-full scale-125'}
          />
        </div>
        <div
          class="flex flex-col w-full h-1/3 items-center justify-around gap-6"
        >
          <ButtonLink
            href="/productos/geles"
            variant={'default'}
            className="font-fredoka text-primary-800 text-xs desktop:text-base font-normal rounded-2xl bg-primary-300 "
          >
            <HandSoap /> Geles</ButtonLink
          >
        </div>
      </div>
      <!-- unguentos -->
      <div
        class="flex flex-col tablet:col-span-auto tablet:row-span-auto items-center justify-center py-8 h-fit w-[320px] tablet:w-full tablet:h-full gap-6 rounded-3xl bg-primary-100/20"
      >
        <div
          class="w-full h-[252px] tablet:h-[102px] laptop:h-[205px] desktop:h-[303px] overflow-hidden"
        >
          <Image
            src={unguentos}
            alt={'ungüentos'}
            layout="responsive"
            class={'w-full h-full'}
          />
        </div>
        <div
          class="flex flex-col w-full h-1/3 items-center justify-around gap-6"
        >
          <ButtonLink
            href="/productos/unguentos"
            variant={'default'}
            className="font-fredoka text-primary-800 text-xs desktop:text-base font-normal rounded-2xl bg-primary-300 "
          >
            <JarLabel /> Ungüentos</ButtonLink
          >
        </div>
      </div>
    </div>
  </div>
</article>
