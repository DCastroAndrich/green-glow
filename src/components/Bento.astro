---
import { Image } from 'astro:assets';

import { ButtonLink } from '@/components/custom/ButtonLink';

import {
  Drop,
  Coin,
  HandSoap,
  FlowerLotus,
  MarkerCircle,
  JarLabel,
} from '@phosphor-icons/react';

import products from '@/assets/prod-Todos-los-productos.webp';
import aceites from '@/assets/prod-Aceite-anti-stress.webp';
import cremas from '@/assets/prod-Crema-descontracturante.webp';
import cosmeticos from '@/assets/prod-Serum-facial.webp';
import geles from '@/assets/prod-Gel-de-limpieza.webp';
import unguentos from '@/assets/prod-Unguento-medicinales.webp';
---

<article>
  <div class="flex flex-col items-center gap-10 py-10 pl-10">
    <h2
      class="font-commissioner text-3xl font-bold text-primary-500 tablet:text-4xl"
    >
      Explora nuestro catálogo
    </h2>
    <p
      class="font-fredoka text-xs font-medium text-primary-300 tablet:text-xl tablet:font-medium"
    >
      Encuentra el producto que se adecue a tus necesidades
    </p>
  </div>
  <!-- Todos los productos -->
  <div class="flex flex-col items-center">
    <div
      class="relative flex h-fit w-full flex-col items-center gap-6 py-10 tablet:grid tablet:w-11/12 tablet:grid-cols-5 tablet:grid-rows-2 tablet:py-11"
    >
      <div
        class="flex h-fit w-[320px] flex-col items-center justify-center gap-10 rounded-3xl bg-primary-100/20 tablet:col-span-2 tablet:row-span-2 tablet:size-full"
      >
        <div
          class="flex h-1/3 w-full flex-col items-center justify-evenly gap-6 pt-3 mobile:pt-0"
        >
          <h4
            class="text-center font-commissioner text-2xl font-semibold text-primary-500 laptop:text-4xl"
          >
            Todos los productos
          </h4>
          <p
            class="text-wrap text-center font-fredoka text-xs font-light text-primary-300 tablet:text-base laptop:text-xl"
          >
            Descubre todos nuestros productos especialmente elaborados con los
            mejores ingredientes
          </p>
          <ButtonLink
            href="/products"
            variant={'default'}
            className="rounded-2xl bg-primary-300 font-fredoka text-xs font-normal text-primary-800 desktop:text-base "
          >
            <FlowerLotus /> Todos los productos</ButtonLink
          >
        </div>
        <div
          class="h-[190px] w-full overflow-hidden rounded-b-xl tablet:h-[170px] tablet:rounded-none laptop:h-[325px] desktop:h-[473px]"
        >
          <Image
            src={products}
            alt={'Todo el catálogo de productos'}
            width={800}
            height={800}
            format="webp"
            sizes="(max-width: 1024px) 100vw, 20vw"
          />
        </div>
      </div>

      <!-- Aceites -->

      <div
        class="tablet:col-span-auto tablet:row-span-auto flex h-fit w-[320px] flex-col items-center justify-center gap-6 rounded-3xl bg-primary-100/20 py-8 tablet:size-full"
      >
        <div
          class="h-[252px] w-full overflow-hidden tablet:h-[102px] laptop:h-[205px] desktop:h-[303px]"
        >
          <Image
            src={aceites}
            alt={'Categoria de productos: Aceites'}
            width={800}
            height={800}
            format="webp"
            sizes="(max-width: 1024px) 100vw, 20vw"
            class={'size-full scale-150 object-cover'}
          />
        </div>
        <div
          class="flex h-1/3 w-full flex-col items-center justify-around gap-6"
        >
          <ButtonLink
            href="/productos/aceites"
            variant={'default'}
            className="rounded-2xl bg-primary-300 font-fredoka text-xs font-normal text-primary-800 desktop:text-base "
          >
            <Drop /> Aceites</ButtonLink
          >
        </div>
      </div>
      <!-- cosméticos -->
      <div
        class="flex h-fit w-[320px] flex-col items-center justify-center gap-6 rounded-3xl bg-primary-100/20 pt-3 mobile:flex-row mobile:pt-0 tablet:col-span-2 tablet:row-span-1 tablet:size-full"
      >
        <div
          class="ml-2 flex size-full flex-col items-center justify-center gap-6 mobile:w-1/2"
        >
          <h4
            class="text-center font-commissioner text-2xl font-semibold text-primary-500 laptop:text-4xl"
          >
            Cosméticos
          </h4>
          <p
            class="text-wrap text-center font-fredoka text-xs font-light text-primary-300 laptop:text-xl"
          >
            Conoce nuestra variedad de cosméticos elaborados con ingredientes
            naturales
          </p>
          <ButtonLink
            href="/productos/cosméticos"
            variant={'default'}
            className="rounded-2xl bg-primary-300 font-fredoka text-xs font-normal text-primary-800 desktop:text-base "
          >
            <MarkerCircle /> Cosméticos</ButtonLink
          >
        </div>
        <div class="size-full overflow-hidden mobile:w-1/2">
          <Image
            src={cosmeticos}
            alt={'Categoria de productos: Cosméticos'}
            width={800}
            height={800}
            format="webp"
            sizes="(max-width: 1024px) 100vw, 20vw"
            class={'size-full rounded-b-xl object-cover mobile:rounded-r-3xl mobile:rounded-bl-none'}
          />
        </div>
      </div>
      <!-- Cremas -->
      <div
        class="tablet:col-span-auto tablet:row-span-auto flex h-fit w-[320px] flex-col items-center justify-center gap-6 rounded-3xl bg-primary-100/20 py-8 tablet:size-full"
      >
        <div
          class="h-[252px] w-full overflow-hidden tablet:h-[102px] laptop:h-[205px] desktop:h-[303px]"
        >
          <Image
            src={cremas}
            alt={'Categoria de productos: Cremas'}
            width={800}
            height={800}
            format="webp"
            sizes="(max-width: 1024px) 100vw, 20vw"
            class={'ml-10 size-full scale-150 object-cover'}
          />
        </div>
        <div
          class="flex h-1/3 w-full flex-col items-center justify-around gap-6"
        >
          <ButtonLink
            href="/productos/cremas"
            variant={'default'}
            className="rounded-2xl bg-primary-300 font-fredoka text-xs font-normal text-primary-800 desktop:text-base "
          >
            <Coin /> Cremas</ButtonLink
          >
        </div>
      </div>
      <!-- Geles -->
      <div
        class="tablet:col-span-auto tablet:row-span-auto flex h-fit w-[320px] flex-col items-center justify-center gap-6 rounded-3xl bg-primary-100/20 py-8 tablet:size-full"
      >
        <div
          class="h-[252px] w-full overflow-hidden tablet:h-[102px] laptop:h-[205px] desktop:h-[303px]"
        >
          <Image
            src={geles}
            alt={'Categoria de productos: Geles'}
            width={800}
            height={800}
            format="webp"
            sizes="(max-width: 1024px) 100vw, 20vw"
            class={'size-full scale-125 object-cover'}
          />
        </div>
        <div
          class="flex h-1/3 w-full flex-col items-center justify-around gap-6"
        >
          <ButtonLink
            href="/productos/geles"
            variant={'default'}
            className="rounded-2xl bg-primary-300 font-fredoka text-xs font-normal text-primary-800 desktop:text-base "
          >
            <HandSoap /> Geles</ButtonLink
          >
        </div>
      </div>
      <!-- unguentos -->
      <div
        class="tablet:col-span-auto tablet:row-span-auto flex h-fit w-[320px] flex-col items-center justify-center gap-6 rounded-3xl bg-primary-100/20 py-8 tablet:size-full"
      >
        <div
          class="h-[252px] w-full overflow-hidden tablet:h-[102px] laptop:h-[205px] desktop:h-[303px]"
        >
          <Image
            src={unguentos}
            alt={'Categoria de productos: Ungüentos'}
            width={800}
            height={800}
            format="webp"
            sizes="(max-width: 1024px) 100vw, 20vw"
            class={'size-full object-cover'}
          />
        </div>
        <div
          class="flex h-1/3 w-full flex-col items-center justify-around gap-6"
        >
          <ButtonLink
            href="/productos/unguentos"
            variant={'default'}
            className="rounded-2xl bg-primary-300 font-fredoka text-xs font-normal text-primary-800 desktop:text-base "
          >
            <JarLabel /> Ungüentos</ButtonLink
          >
        </div>
      </div>
    </div>
  </div>
</article>
