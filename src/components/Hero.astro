---
import { Image } from 'astro:assets';
import logo from '@/assets/Logo.png';
import heroLetters from '@/assets/heroLetters.png';
import bgHero from '@/assets/bg-hero.webp';
---

<header
  id="hero-section"
  class={`flex h-screen w-full flex-col items-center justify-center bg-cover bg-center bg-no-repeat`}
  style={`background-image: url('${bgHero.src}')`}
>
  <div class="absolute h-screen w-full bg-black/50"></div>
  <div
    class="flex size-fit flex-col items-center justify-center gap-0 mobile:flex-row"
  >
    <Image
      src={logo}
      alt={'green glow logo'}
      width={550}
      height={550}
      class="h-auto w-3/5 drop-shadow-xl mobile:w-1/2"
    />
    <div
      class="flex size-fit flex-col items-center justify-center mobile:items-start"
    >
      <Image
        src={heroLetters}
        alt={'green glow'}
        class={'w-4/5 drop-shadow-xl'}
      />
      <h1
        class="relative z-10 font-commissioner text-lg font-semibold text-primary-500 mobile:text-3xl"
      >
        FITOCOSMETICA
      </h1>
    </div>
  </div>
</header>
