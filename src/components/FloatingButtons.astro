    onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-4 h-4 text-white"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 15l7-7 7 7"></path>
    </svg>
  </button>

  <!-- WhatsApp Button with Popover -->
  <div class="relative">
    <button
      id="whatsAppBtn"
      aria-label="Contactar por WhatsApp"
      class="bg-green-500 hover:bg-green-600 rounded-full shadow-lg p-2 mobile:p-4 flex items-center justify-center transition-all duration-500 ease-out opacity-0 translate-y-4 pointer-events-none"
      type="button"
      onclick="toggleWaMenu(event)"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 mobile:w-7 mobile:h-7 text-white"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
