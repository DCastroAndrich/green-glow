        ></path>
      </svg>
    </button>
    <!-- Poporver -->
    <div
      id="waMenu"
      class="hidden absolute right-full mr-4 bottom-1/2 translate-y-1/2 flex-col bg-transparent backdrop-blur-md rounded-lg shadow-lg p-2 min-w-[180px] border border-primary-400"
      role="menu"
      aria-label="Elegir tipo de contacto"
    >
      {
        whatsappOptions.map((opt) => (
          <a
            href={`https://wa.me/${opt.number}?text=${encodeURIComponent(opt.message)}`}
