<script is='client="load"'>
  // Mostrar/ocultar el popover
  function toggleWaMenu(event) {
    event.stopPropagation();
    const menu = document.getElementById('waMenu');
    menu?.classList.toggle('hidden');
  }
  //cerrar el popover
  document.addEventListener('click', function (e) {
    const menu = document.getElementById('waMenu');
    const btn = document.getElementById('whatsAppBtn');
    if (
      menu &&
      !menu.classList.contains('hidden') &&
      btn &&
      !(btn === e.target || btn.contains(e.target)) &&
      !(menu === e.target || menu.contains(e.target))
    ) {
      menu.classList.add('hidden');
    }
  });

  if (typeof window !== 'undefined') {
    const scrollBtn = document.getElementById('scrollToTopBtn');
    const waBtn = document.getElementById('whatsAppBtn');
    const hero = document.getElementById('hero-section');
    const show = () => {
      scrollBtn?.classList.add(
        'opacity-100',
        'translate-y-0',
        'pointer-events-auto'
      );
      scrollBtn?.classList.remove(
        'opacity-0',
        'translate-y-4',
        'pointer-events-none'
      );
      waBtn?.classList.add(
        'opacity-100',
        'translate-y-0',
        'pointer-events-auto'
      );
      waBtn?.classList.remove(
        'opacity-0',
        'translate-y-4',
        'pointer-events-none'
      );
    };
    const hide = () => {
      scrollBtn?.classList.remove(
        'opacity-100',
        'translate-y-0',
        'pointer-events-auto'
      );
      scrollBtn?.classList.add(
        'opacity-0',
        'translate-y-4',
        'pointer-events-none'
      );
      waBtn?.classList.remove(
        'opacity-100',
        'translate-y-0',
        'pointer-events-auto'
      );
      waBtn?.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
    };
    if (hero && scrollBtn && waBtn) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) {
            show();
          } else {
            hide();
          }
        },
        { threshold: 0 }
      );
      observer.observe(hero);
      hide();
    } else if (scrollBtn && waBtn) {
      show();
    }
  }
</script>
