---
import Layout from '@/layouts/Layout.astro';
import '@/styles/globals.css';
import HowToBuyDialog from '@/components/islands/HowToBuyDialog';
import ProductDetailTabs from '@/components/islands/ProductDetailTabs';
import { products } from '../../../data/products-data.ts';
import Breadcrumbs from '@/components/islands/Breadcrumbs';
import ProductImageCarousel from '@/components/islands/ProductImageCarousel';

export async function getStaticPaths() {
  return products.map((product) => {
    const categoria = product.category.toLowerCase();
    return {
      params: {
        categoria,
        id: product.id.toString(),
      },
      props: { product, categoria },
    };
  });
}

const { product, categoria } = Astro.props;

// Mapeo de categorías para mostrar nombres correctos
const categoryNames: Record<string, string> = {
  aceites: 'Aceites',
  cosméticos: 'Cosméticos',
  cremas: 'Cremas',
  geles: 'Geles',
  unguentos: 'Unguentos',
};

const displayCategoryName = categoryNames[categoria] || categoria;
const images = product.images?.length ? product.images : [product.imageUrl];
const imageSrcs = images.map((image) => image.src);
---

<Layout
  title={`Green Glow® - ${product.name}`}
  description={product.shortDescription}
>
  <main
    class="flex h-fit min-h-screen w-full flex-col items-center justify-start gap-3"
  >
    <Breadcrumbs
      productName={product.name}
      categoryName={displayCategoryName}
      categorySlug={categoria}
    />

    <div
      class="flex size-full min-h-screen flex-col items-center justify-start gap-3 desktop:flex-row desktop:items-start"
    >
      <div
        class="mt-4 h-full w-11/12 items-center laptop:h-[1200px] desktop:ml-6"
      >
        <ProductImageCarousel
          client:visible
          images={imageSrcs}
          alt={product.name}
        />
      </div>

      <section
        class="flex h-fit w-full flex-col items-center justify-start gap-7 p-4"
      >
        <!-- titulo -->
        <div
          class="flex h-fit w-full flex-col items-start justify-center gap-8 tablet:w-11/12"
        >
          <h2
            class="h-fit w-full text-balance text-center font-commissioner text-2xl font-semibold text-primary-400 tablet:text-wrap tablet:text-4xl laptop:text-5xl"
          >
            {product.name}
          </h2>
          <h4
            class="h-fit w-full text-balance text-center font-commissioner text-xl font-semibold text-primary-400 tablet:text-wrap tablet:text-2xl laptop:text-3xl"
          >
            {product.shortDescription}
          </h4>
          <!-- descripcion -->
          <p
            class="h-fit w-full text-pretty font-fredoka text-xs font-light text-primary-300 tablet:pl-4 tablet:text-xl laptop:text-2xl"
          >
            {product.description}
          </p>

          <!-- CAMBIO SUGERIDO PARA VER EL PRECIO SEGUN EL ENVASE -->
          <p
            class="h-fit w-full text-balance text-center font-fredoka text-3xl font-semibold text-primary-400 tablet:pl-4 tablet:text-left tablet:text-5xl"
          >
            {
              product.presentations.length === 1 ? (
                <>
                  ${product.presentations[0].price.toLocaleString('es-AR')}{' '}
                  <span class="text-balance text-center font-fredoka text-lg font-semibold text-primary-700 tablet:pl-4 tablet:text-left tablet:text-xl">
                    ({product.presentations[0].size})
                  </span>
                </>
              ) : (
                <ul class="flex flex-col gap-6">
                  {product.presentations.map((p, index) => (
                    <li key={p.size + index}>
                      <span class="text-balance text-center font-fredoka text-3xl font-semibold text-primary-400 tablet:pl-4 tablet:text-left tablet:text-5xl">
                        ${p.price.toLocaleString('es-AR')}
                      </span>
                      <span class="text-balance text-center font-fredoka text-lg font-semibold text-primary-700 tablet:pl-4 tablet:text-left tablet:text-xl">
                        ({p.size})
                      </span>
                    </li>
                  ))}
                </ul>
              )
            }
          </p>
        </div>
        <div class="h-fit w-11/12">
          <HowToBuyDialog client:visible />
        </div>
        <div class="w-full bg-transparent tablet:w-11/12">
          <ProductDetailTabs client:visible product={product} />
        </div>
      </section>
    </div>
  </main>
</Layout>
