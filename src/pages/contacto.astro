---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import heroLetters from '@/assets/heroLetters.png';
import CopyEmailButton from '@/components/islands/CopyEmailButton.tsx';

import { Envelope, InstagramLogo, WhatsappLogo } from '@phosphor-icons/react';
import '@/styles/globals.css';
---

<Layout title="Green Glow - Contacto">
  <main
    class="flex flex-col tablet:flex-row justify-between w-full items-center h-full gap-10"
  >
    <!-- TEXTO PRINCIPAL -->
    <div
      class="mt-5 tablet:ml-8 flex flex-col items-center mobile:items-start justify-center tablet:justify-start w-full tablet:w-1/3 h-1/3 tablet:h-full"
    >
      <Image
        src={heroLetters}
        alt={'green glow'}
        class={'drop-shadow-xl w-3/5'}
      />
      <h1
        class="text-primary-500 font-commissioner font-semibold text-sm mobile:text-2xl z-10 relative"
      >
        FITOCOSMETICA
      </h1>
    </div>

    <!-- CONTACTOS -->
    <div
      class="relative flex flex-row items-center justify-center h-2/3 tablet:h-full w-full tablet:w-2/3 overflow-hidden"
    >
      <img
        src="/src/assets/Logo.png"
        alt="logo"
        class="absolute inset-0 w-full h-full object-cover z-0 opacity-25
         tablet:w-1/2 tablet:h-1/2 tablet:left-1/2 tablet:top-1/2 tablet:-translate-x-1/2 tablet:-translate-y-1/2"
        loading="lazy"
        aria-hidden="true"
      />
      <div
        class="relative h-full z-10 flex flex-col items-center backdrop-blur-sm gap-5 tablet:gap-8 w-full p-12 text-primary-400 text-nowrap"
      >
        <div class="w-full flex flex-row items-start justify-start">
          <a
            target="_blank"
            href="https://www.instagram.com/greenglow_ar/"
            class="w-full flex flex-row items-center gap-2 tablet:gap-5 text-base tablet:text-lg laptop:text-3xl"
          >
            <InstagramLogo
              className="w-6 tablet:w-9 h-6 tablet:h-9 text-primary-500"
            /><p>@greenglow_ar</p>
          </a>
        </div>
        <div class="w-full flex flex-row items-start justify-start">
          <a
            href="#"
            class="w-full flex flex-row items-center gap-2 tablet:gap-5 text-base tablet:text-lg laptop:text-3xl"
          >
            <Envelope
              className="w-6 tablet:w-9 h-6 tablet:h-9 text-primary-500"
            />
            <CopyEmailButton client:load email="greenglow.ar@gmail.com" />
          </a>
        </div>
        <div class="w-full flex flex-col gap-5 tablet:gap-8">
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://wa.me/542216828979?text=Hola%2C%20quiero%20hacer%20un%20pedido"
            class="w-full flex flex-row items-center gap-2 tablet:gap-5 text-base tablet:text-lg laptop:text-3xl"
          >
            <WhatsappLogo
              className="w-6 tablet:w-9 h-6 tablet:h-9 text-primary-500"
            />
            <p>
              Pedidos: <span class="hover:underline">+54 221 682-8979</span>
            </p>
          </a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://wa.me/542215676592?text=Hola%2C%20quiero%20informaci%C3%B3n"
            class="w-full flex flex-row items-center gap-2 tablet:gap-5 text-base tablet:text-lg laptop:text-3xl"
          >
            <WhatsappLogo
              className="w-6 tablet:w-9 h-6 tablet:h-9 text-primary-500"
            />
            <p>
              Info: <span class="hover:underline">+54 221 567-6592</span>
            </p>
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
