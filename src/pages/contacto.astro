---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import heroLetters from '@/assets/heroLetters.webp';
import CopyEmailButton from '@/components/islands/CopyEmailButton.tsx';
import logo from '@/assets/Logo.webp';

import { Envelope, InstagramLogo, WhatsappLogo } from '@phosphor-icons/react';
import '@/styles/globals.css';
---

<Layout
  title="Green Glow - Contacto"
  description="Contactá a Green Glow para consultas, pedidos o información sobre nuestros productos de fitocosmética natural. ¡Estamos para ayudarte!"
>
  <main
    class="flex size-full flex-col items-center justify-between gap-10 laptop:flex-row"
  >
    <div
      class="flex size-fit flex-col items-center justify-center gap-0 laptop:flex-row"
    >
      <Image
        src={logo}
        alt="green glow logo"
        width={550}
        height={550}
        class="h-auto w-3/5 drop-shadow-xl mobile:w-1/2"
        format="webp"
        sizes="(max-width: 1920px) 50vw, 33vw"
        priority
      />
      <div
        class="flex size-fit flex-col items-center justify-center gap-10 laptop:items-start"
      >
        <Image
          src={heroLetters}
          alt="Green Glow - Marca de cosmética natural"
          width={1024}
          height={1024}
          class="w-4/5 drop-shadow-xl"
          format="webp"
          sizes="(max-width: 1920px) 80vw, 40vw"
        />
        <h1
          class="relative z-10 font-commissioner text-lg font-semibold text-primary-500 mobile:text-3xl"
        >
          FITOCOSMETICA
        </h1>
      </div>

      <!-- CONTACTOS -->
      <div
        class="mt-6 flex h-2/3 w-full flex-row items-center justify-center overflow-hidden laptop:h-full laptop:w-2/3"
      >
        <div
          class="z-10 flex size-full flex-col items-start gap-5 text-nowrap p-12 text-primary-400 backdrop-blur-sm tablet:items-center tablet:gap-10"
        >
          <h2
            class="z-10 font-commissioner text-sm font-semibold text-primary-500 mobile:text-6xl"
          >
            CONTACTO
          </h2>
          <div
            class="flex font-fredoka w-full flex-row items-start justify-start"
          >
            <a
              target="_blank"
              href="https://www.instagram.com/greenglow_ar/"
              class="flex w-full flex-row items-center gap-2 text-base tablet:gap-5 tablet:text-lg laptop:text-3xl"
              rel="noreferrer"
            >
              <InstagramLogo
                className="size-6 text-primary-500 tablet:size-9"
              /><p>@greenglow_ar</p>
            </a>
          </div>
          <div class="flex w-full flex-row items-start justify-start">
            <a
              href="#"
              class="flex w-full flex-row items-center gap-2 text-base tablet:gap-5 tablet:text-lg laptop:text-3xl"
            >
              <Envelope className="size-6 text-primary-500 tablet:size-9" />
              <CopyEmailButton client:load email="greenglow.ar@gmail.com" />
            </a>
          </div>
          <div class="flex w-full flex-col gap-5 tablet:gap-8">
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://wa.me/542216828979?text=Hola%2C%20quiero%20hacer%20un%20pedido"
              class="flex w-full flex-row items-center gap-2 text-base tablet:gap-5 tablet:text-lg laptop:text-3xl"
            >
              <WhatsappLogo className="size-6 text-primary-500 tablet:size-9" />
              <p>
                Pedidos: <span class="hover:underline">+54 221 682-8979</span>
              </p>
            </a>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://wa.me/542215676592?text=Hola%2C%20quiero%20informaci%C3%B3n"
              class="flex w-full flex-row items-center gap-2 text-base tablet:gap-5 tablet:text-lg laptop:text-3xl"
            >
              <WhatsappLogo className="size-6 text-primary-500 tablet:size-9" />
              <p>
                Info: <span class="hover:underline">+54 221 567-6592</span>
              </p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
