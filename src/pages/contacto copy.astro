---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import heroLetters from '@/assets/heroLetters.png';
import CopyEmailButton from '@/components/islands/CopyEmailButton.tsx';
import logo from '@/assets/Logo.png';

import { Envelope, InstagramLogo, WhatsappLogo } from '@phosphor-icons/react';
import '@/styles/globals.css';
---

<Layout title="Green Glow - Contacto">
  <main
    class="flex flex-col laptop:flex-row justify-between w-full items-center h-full gap-10"
  >
    <!-- HERO -->

    <div class="flex flex-col gap-0 items-center justify-center h-fit w-fit">
      <Image
        src={logo}
        alt={'green glow logo'}
        width={550}
        height={550}
        class="drop-shadow-xl w-3/5 mobile:w-1/2 h-auto"
      />
      <div
        class="flex flex-col items-center mobile:items-start justify-center w-fit h-fit"
      >
        <Image
          src={heroLetters}
          alt={'green glow'}
          class={'drop-shadow-xl w-4/5'}
        />
        <h1
          class="text-primary-500 font-commissioner font-semibold text-lg mobile:text-3xl z-10 relative"
        >
          FITOCOSMETICA
        </h1>
      </div>

      <!-- CONTACTOS -->
      <div
        class="flex flex-col items-center justify-center h-2/3 tablet:h-full w-full overflow-hidden"
      >
        <div
          class="h-full z-10 flex flex-col items-start backdrop-blur-sm gap-5 tablet:gap-10 w-full p-12 text-primary-400 text-nowrap"
        >
          <h2
            class="text-primary-500 font-commissioner font-semibold text-sm mobile:text-6xl z-10"
          >
            CONTACTO
          </h2>
          <div class="w-full flex flex-row items-start justify-start">
            <a
              target="_blank"
              href="https://www.instagram.com/greenglow_ar/"
              class="w-full flex flex-row items-center gap-2 tablet:gap-5 text-base tablet:text-lg laptop:text-3xl"
            >
              <InstagramLogo
                className="w-6 tablet:w-9 h-6 tablet:h-9 text-primary-500"
              /><p>@greenglow_ar</p>
            </a>
          </div>
          <div class="w-full flex flex-row items-start justify-start">
            <a
              href="#"
              class="w-full flex flex-row items-center gap-2 tablet:gap-5 text-base tablet:text-lg laptop:text-3xl"
            >
              <Envelope
                className="w-6 tablet:w-9 h-6 tablet:h-9 text-primary-500"
              />
              <CopyEmailButton client:load email="greenglow.ar@gmail.com" />
            </a>
          </div>
          <div class="w-full flex flex-col gap-5 tablet:gap-8">
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://wa.me/542216828979?text=Hola%2C%20quiero%20hacer%20un%20pedido"
              class="w-full flex flex-row items-center gap-2 tablet:gap-5 text-base tablet:text-lg laptop:text-3xl"
            >
              <WhatsappLogo
                className="w-6 tablet:w-9 h-6 tablet:h-9 text-primary-500"
              />
              <p>
                Pedidos: <span class="hover:underline">+54 221 682-8979</span>
              </p>
            </a>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://wa.me/542215676592?text=Hola%2C%20quiero%20informaci%C3%B3n"
              class="w-full flex flex-row items-center gap-2 tablet:gap-5 text-base tablet:text-lg laptop:text-3xl"
            >
              <WhatsappLogo
                className="w-6 tablet:w-9 h-6 tablet:h-9 text-primary-500"
              />
              <p>
                Info: <span class="hover:underline">+54 221 567-6592</span>
              </p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
