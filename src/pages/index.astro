---
import AboutIndex from '@/components/AboutIndex.astro';
import Bento from '@/components/Bento.astro';
import BestSellers from '@/components/BestSellers.astro';
import Hero from '@/components/Hero.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/globals.css';
---

<Layout title="Green Glow">
  <main class="flex h-fit w-full flex-col items-center justify-between gap-10">
    <Hero />
    <AboutIndex />
    <h2
      class="text-center font-commissioner text-3xl font-bold text-primary-500 tablet:text-5xl"
    >
      NUESTROS PRODUCTOS
    </h2>
    <BestSellers />
    <Bento />
  </main>
</Layout>
