---
import AboutIndex from '@/components/AboutIndex.astro';
import Bento from '@/components/Bento.astro';
import BestSellers from '@/components/BestSellers.astro';
import Hero from '@/components/Hero.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/globals.css';
---

<Layout title="Green Glow">
  <main class="flex flex-col justify-between w-full items-center h-fit gap-10">
    <Hero />
    <AboutIndex />
    <h2
      class="font-commissioner text-primary-500 font-bold text-3xl text-center tablet:text-5xl"
    >
      NUESTROS PRODUCTOS
    </h2>
    <BestSellers />
    <Bento />
  </main>
</Layout>
