---
import Layout from '@/layouts/Layout.astro';
import '@/styles/globals.css';
import { products } from '@/data/products-data';
import ProductDisplay from '@/components/islands/ProductDisplay';
import Breadcrumbs from '@/components/islands/Breadcrumbs';
---

<!-- contenedor -->
<Layout title="Green Glow - Nuestro productos">
  <main
    class="flex flex-col justify-start w-full items-center h-fit min-h-screen gap-y-8"
  >
    <Breadcrumbs productName="Productos" />
    <div class="w-full text-center pl-4">
      <h2 class="font-commissioner text-center text-primary-500 text-4xl font-semibold">
        Nuestros productos
      </h2>
    </div>
    <ProductDisplay client:load products={products} selectedCategory={null} allProducts={products} />
  </main>
</Layout>
